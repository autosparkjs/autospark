{
    "name": "@autospark/theme",
    "version": "1.0.7",
    "repository": {
        "type": "git",
        "url": "https://github.com/zhangfisher/autospark.git"
    },
    "files": [
        "dist",
        "readme.md"
    ],
    "type": "module",
    "module": "src/index.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./global": {
            "import": "./dist/autospark.theme.js",
            "require": "./dist/autospark.theme.js"
        },
        "./index.css": {
            "import": "./dist/index.css",
            "require": "./dist/index.css"
        },
        "./themes/*.css": {
            "import": "./dist/*.css",
            "require": "./dist/*.css"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && bun run build:css && bun run build:types && bun run build:themes && bun run build:docs-css",
        "build:css": "lessc src/styles/index.less dist/index.css",
        "build:types": "tsc -p tsconfig.build.json",
        "build:themes": "bun scripts/generate-theme.ts --all",
        "build:docs-css": "lessc docs.less ../../docs/public/autospark-theme.css"
    },
    "dependencies": {
        "@autospark/utils": "workspace:*",
        "@yosulramp/material-color-palette-js": "^1.0.4"
    },
    "devDependencies": {
        "@autospark/plugins": "workspace:*",
        "@types/bun": "^1.4.3",
        "autospark": "workspace:*",
        "autostore": "^4.7.1",
        "less": "^4.6.4",
        "lit": "^3.3.3",
        "typescript": "^7.0.2",
        "vanilla-picker": "^2.12.3",
        "vite": "^8.0.3"
    },
    "packageManager": "^bun@1.3.6"
}